---
import ArticleDirectives from "@noetheca/knowledge-engine/components/ArticleDirectives.astro";
import ConceptRelations from "@noetheca/knowledge-engine/components/ConceptRelations.astro";
import KnowledgeLayout from "@noetheca/knowledge-engine/components/KnowledgeLayout.astro";
import {
  getUiStrings,
  type Concept,
  type KnowledgeLanguageOption,
} from "@noetheca/knowledge-engine";
import { render, type CollectionEntry } from "astro:content";
import { loadConceptEntries } from "../lib/concept-entries";
import { siteLanguages } from "../lib/languages";
import { conceptRoute, withBase } from "../lib/routes";

interface Props {
  entry: CollectionEntry<"concepts">;
  concept: Concept;
  relationTitles: Record<string, string>;
  languages: KnowledgeLanguageOption[];
}

export async function getStaticPaths() {
  const records = await loadConceptEntries();
  const translations = new Map(
    records.map(({ entry, concept }) => [
      `${concept.metadata.id}:${entry.data.locale}`,
      entry,
    ]),
  );

  return records.map(({ entry, concept }) => {
    const conceptId = concept.metadata.id;
    const relationTitles = Object.fromEntries(
      [...concept.metadata.prerequisites, ...concept.metadata.related]
        .map((id) => [
          id,
          translations.get(`${id}:${entry.data.locale}`)?.data.title,
        ])
        .filter((pair): pair is [string, string] => pair[1] !== undefined),
    );
    const languages = siteLanguages.map((language) => ({
      ...language,
      href: translations.has(`${conceptId}:${language.locale}`)
        ? withBase(conceptRoute(language.locale, conceptId))
        : undefined,
    }));
    return {
      params: {
        slug: conceptRoute(entry.data.locale, conceptId),
      },
      props: { entry, concept, relationTitles, languages },
    };
  });
}

const { entry, concept, relationTitles, languages } = Astro.props;
const { Content } = await render(entry);
const locale = entry.data.locale;
const ui = getUiStrings(locale).article;

function relation(id: string) {
  const title = relationTitles[id];
  return {
    id,
    title,
    href: title ? withBase(conceptRoute(locale, id)) : undefined,
  };
}

const sourcePath = entry.filePath?.replaceAll("\\", "/");
const editUrl = sourcePath
  ? `https://github.com/noetheca/mathematics/edit/main/${sourcePath}`
  : "https://github.com/noetheca/mathematics";
---

<KnowledgeLayout
  title={entry.data.title}
  summary={entry.data.summary}
  locale={locale}
  domain="mathematics"
  languages={languages}
>
  <article>
    <p class="eyebrow">{concept.metadata.id.replaceAll("/", " / ")}</p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>

    <div class="prose">
      <Content />
    </div>
    <ArticleDirectives />

    <ConceptRelations
      prerequisites={concept.metadata.prerequisites.map(relation)}
      related={concept.metadata.related.map(relation)}
      ariaLabel={ui.relationsLabel}
      labels={{
        prerequisites: ui.prerequisites,
        related: ui.related,
        empty: ui.noRelations,
      }}
    />

    <section aria-labelledby="sources">
      <h2 id="sources">{ui.sources}</h2>
      {
        entry.data.sources.length > 0 ? (
          <ul>
            {entry.data.sources.map((source) => (
              <li>
                {typeof source === "string" ? (
                  <a href={source}>{source}</a>
                ) : (
                  <>
                    <a href={source.url}>{source.title}</a>
                    {source.note && <span> — {source.note}</span>}
                  </>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">{ui.sourcesPending}</p>
        )
      }
    </section>

    <p class="content-state">
      <a href={editUrl}>GitHub</a>
      <a href="https://github.com/noetheca/mathematics/issues/new/choose">
        {ui.reportIssue}
      </a>
    </p>
  </article>
</KnowledgeLayout>

<style>
  .content-state {
    align-items: center;
    border-block: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-block: 3rem 0;
    padding-block: 0.8rem;
  }

  .prose {
    margin-top: 2.5rem;
  }

  :global(.prose img) {
    height: auto;
    max-width: 100%;
  }

</style>
